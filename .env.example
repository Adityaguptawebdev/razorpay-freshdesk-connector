# Copy this file to .env and fill in your own values. Never commit .env.

# Your Freshdesk subdomain. Accepts "acme", "acme.freshdesk.com" or "https://acme.freshdesk.com".
FRESHDESK_DOMAIN=your-subdomain

# Freshdesk API key (Profile picture > Profile settings > "View API key").
# Use the key of a dedicated, least-privileged agent where possible.
FRESHDESK_API_KEY=your_api_key_here

# --- Optional settings (defaults shown) ---

# How many times to retry rate-limited (429), 5xx, timeout and network failures. Range 0-5.
FRESHDESK_MAX_RETRIES=3

# Per-attempt HTTP timeout in milliseconds. Range 1000-60000.
FRESHDESK_REQUEST_TIMEOUT_MS=10000

# Total time one tool call may spend waiting between retries (Retry-After or backoff), in ms.
# If a wait would exceed it, the tool fails fast with RATE_LIMITED and retry_after_seconds.
# Keep it well below your MCP client's request timeout (often 60s). Range 1000-60000.
FRESHDESK_MAX_RETRY_WAIT_MS=20000

# Expose private (internal agent) notes to the AI agent? Keep "false" for customer-facing agents.
FRESHDESK_INCLUDE_PRIVATE_NOTES=false

# debug | info | warn | error  (logs go to stderr; stdout is reserved for the MCP protocol)
LOG_LEVEL=info
