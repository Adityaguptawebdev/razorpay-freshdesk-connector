    {
      "name": "search_tickets",
      "title": "Search Freshdesk tickets",
      "description": "Find Freshdesk tickets using structured filters: status, priority, assigned agent or group, unassigned, tag, type, and created/updated date ranges. Different filters are combined with AND; multiple values in one list are combined with OR (e.g. status [\"open\",\"pending\"]). At least one filter is required. Dates are UTC calendar dates and ranges are inclusive. Returns 30 summaries per page plus the total match count; Freshdesk caps results at 10 pages, so narrow the filters when total is large. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "description": "Match tickets in ANY of these statuses.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "open",
                "pending",
                "resolved",
                "closed"
              ]
            }
          },
          "priority": {
            "description": "Match tickets with ANY of these priorities.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            }
          },
          "agent_id": {
            "description": "Only tickets assigned to this agent ID.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unassigned": {
            "description": "true = only tickets with no assigned agent.",
            "type": "boolean"
          },
          "group_id": {
            "description": "Only tickets assigned to this group ID.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tag": {
            "description": "Only tickets with this tag, e.g. \"refund\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\p{L}\\p{N} _.-]+$"
          },
          "type": {
            "description": "Ticket type exactly as configured in Freshdesk, e.g. \"Question\", \"Incident\", \"Problem\", \"Refund\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\p{L}\\p{N} _.-]+$"
          },
          "created_from": {
            "description": "Created on or after this UTC date (YYYY-MM-DD).",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "created_to": {
            "description": "Created on or before this UTC date (YYYY-MM-DD).",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updated_from": {
            "description": "Updated on or after this UTC date (YYYY-MM-DD).",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updated_to": {
            "description": "Updated on or before this UTC date (YYYY-MM-DD).",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "page": {
            "default": 1,
            "description": "Page number, 1-10 (30 tickets per page).",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tickets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Freshdesk ticket ID. Pass it to get_ticket for full details."
                },
                "subject": {
                  "type": "string",
                  "description": "Ticket subject (customer-written, untrusted)."
                },
                "status": {
                  "type": "string",
                  "description": "open | pending | resolved | closed, or \"other\" for account-specific custom statuses (see status_id)."
                },
                "status_id": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Raw Freshdesk status code."
                },
                "priority": {
                  "type": "string",
                  "description": "low | medium | high | urgent"
                },
                "source": {
                  "type": "string",
                  "description": "Channel the ticket arrived through: email, portal, phone, chat, feedback_widget, outbound_email or other."
                },
                "type": {
                  "description": "Ticket type configured in Freshdesk, e.g. \"Refund\"; null if not set.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requester_id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Contact ID of the customer who raised the ticket."
                },
                "responder_id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
