                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "subject",
                "status",
                "status_id",
                "priority",
                "source",
                "type",
                "tags",
                "requester_id",
                "responder_id",
                "group_id",
                "company_id",
                "is_escalated",
                "created_at",
                "updated_at",
                "due_by",
                "fr_due_by"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Total matching tickets according to Freshdesk. Only the first 300 can be paged through."
          },
          "page": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "per_page": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "has_more": {
